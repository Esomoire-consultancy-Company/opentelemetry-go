# Esomoire Genesis Control Plane environment template
# Copy this file to .env on the server and fill values privately.
# Never commit the filled .env file to GitHub.

# -----------------------------------------------------------------------------
# Server identity
# -----------------------------------------------------------------------------
GENESIS_NODE_NAME="genesis-node-01"
GENESIS_NODE_ID="gns_bootstrap_001"
GENESIS_SITE_ID="site_bootstrap_001"
GENESIS_PUBLIC_API_BASE_URL="https://your-domain.example"
GENESIS_INTERNAL_API_BASE_URL="http://127.0.0.1"

# -----------------------------------------------------------------------------
# Canonical database - Supabase / Neon / Railway / Cloud SQL Postgres
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# -----------------------------------------------------------------------------
# Object evidence store - Supabase Storage S3-compatible bucket or any S3/R2 store
# -----------------------------------------------------------------------------
OBJECT_STORE_BUCKET="genesis-evidence"
OBJECT_STORE_ENDPOINT="https://PROJECT_REF.storage.supabase.co/storage/v1/s3"
OBJECT_STORE_REGION="PROJECT_REGION"
OBJECT_STORE_FORCE_PATH_STYLE="true"
OBJECT_STORE_ACCESS_KEY_ID="replace_with_server_side_access_key_id"
OBJECT_STORE_SECRET_ACCESS_KEY="replace_with_server_side_secret_access_key"

# -----------------------------------------------------------------------------
# JWT authority - prefer asymmetric JWT verification / JWKS where available
# -----------------------------------------------------------------------------
JWT_ISSUER="https://PROJECT_REF.supabase.co/auth/v1"
JWT_AUDIENCE="authenticated"
JWT_JWKS_URL="https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"
JWT_SIGNING_KEY="replace_only_if_using_private_internal_signing"

# -----------------------------------------------------------------------------
# OpenTelemetry / Warden observability - Grafana Cloud or collector endpoint
# -----------------------------------------------------------------------------
OTEL_SERVICE_NAME="genesis-control-plane"
OTEL_RESOURCE_ATTRIBUTES="deployment.environment=bootstrap,service.namespace=esomoire.genesis,service.version=0.1.0,service.instance.id=gns_bootstrap_001"
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
OTEL_EXPORTER_OTLP_ENDPOINT="https://otlp-gateway-REGION.grafana.net/otlp"
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic replace_with_grafana_cloud_otlp_header"

# -----------------------------------------------------------------------------
# Optional runtime/cache layer
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"

# -----------------------------------------------------------------------------
# Local service ports
# -----------------------------------------------------------------------------
GENESIS_REGISTRY_PORT="8081"
EMPIREOS_LICENSE_PORT="8082"
RIVEROS_EVIDENCE_PORT="8083"
SILK_PAYMENT_PORT="8084"
WARDEN_OBSERVABILITY_PORT="8085"
